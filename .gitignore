# ================== Project Specific ==================
# 非常にサイズが大きいデータフォルダをすべて無視します
# これが最も重要な設定です
data/

# --------ALL REUNION/
# --------ALL REUNION2/
# --------ALL REUNION3/

# VS Codeのワークスペース設定を無視します
.vscode/


# ================== Python / Jupyter ==================
# Pythonのキャッシュファイル
__pycache__/
*.pyc

# Jupyter Notebookのチェックポイント（将来的に使う可能性のため）
.ipynb_checkpoints/


# ================== Office Temporary Files ==================
# Excelなどを開いたときに自動生成される一時ファイルを無視
~$*.xlsm
~$*.xlsx


# ================== Environment Files ==================
# APIキーなどの秘密情報を保存する.envファイルを無視
*.env

# ================== venv ==================
# 間違えて作ったvenvを無視
.venv/

# ================== logs ==================
echo "logs/" >> .gitignore

*.tar.gz
*.zip
*.db
*.duckdb
duckdb_temp/
.tmp/*.pkl
*.parquet

# ================== shadow_mode ==================
# /workspace/shadow_mode/ 配下は .py 以外を ignore
shadow_mode/*
!shadow_mode/*.py
# === バックアップ・アーカイブ系を ignore ===
**/Archive/
**/Archives/
**/Before*/
**/After*backup*/
**/*_backup/
**/*_FAIL_backup/
**/*修正前*/
**/*凍結*/
**/*問題*/
**/Polars*plan*/
*.bak
*.v[0-9]bak
*.v[0-9][0-9]bak
.tmp/
.temp/
tmp/
logs/Phase_*/
logs/Before*/
